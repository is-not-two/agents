# 环境变量模板：复制为 .env 后填写真实值（.env 不入库）
# 优先级：环境变量 > .env 文件 > config/settings.yaml

# ---- PostgreSQL + pgvector（V1 起使用）----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag_tech_doc
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me

# ---- 嵌入模型可选覆盖（V1 起使用）----
# EMBEDDING_DEVICE=cpu

# ---- MCP 服务端口（V2-d 起使用）----
# MCP_SERVER_PORT=8765

# ---- Web（本机默认回环；服务器必须设置强访问令牌并启用鉴权）----
# WEB_HOST=127.0.0.1
# WEB_PORT=8770
# WORKSPACE_PROFILE=production  # 本地默认 local；生产预检要求显式鉴权
# WORKSPACE_SCHEMA_MODE=verify  # production默认且只允许verify；管理员迁移走独立CLI，不在启动时DDL
# WORKSPACE_ACCESS_TOKEN=替换为随机长令牌
# WORKSPACE_REQUIRE_AUTH=true
# WORKSPACE_MCP_TOKEN=  # 独立随机32位以上，只允许/mcp；启用业务MCP工具时必填，不得与工作台令牌相同
# WITH_RAG=true  # 容器加装 CPU 模型；false 时使用全文查询

# ---- OpenAI 兼容模型 API（未配置或失败时保留纯检索引用）----
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ---- 应用层字段加密（AES-256-GCM；密钥不入库、不写日志）----
# 优先级：SHILIE_ENCRYPTION_KEY（base64/hex） > SHILIE_ENCRYPTION_KEY_FILE > config/settings.yaml
# SHILIE_ENCRYPTION_ENABLED=true
# SHILIE_ENCRYPTION_KEY_FILE=/var/lib/shilie/encryption.key
