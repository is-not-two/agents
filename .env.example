# 环境变量模板：复制为 .env 后填写真实值（.env 不入库）
# 优先级：环境变量 > .env 文件 > config/settings.yaml

# ---- PostgreSQL + pgvector（V1 起使用）----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag_tech_doc
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me

# ---- 嵌入模型可选覆盖（V1 起使用）----
# EMBEDDING_DEVICE=cpu

# ---- MCP 服务端口（V2-d 起使用）----
# MCP_SERVER_PORT=8765

# ---- Web（本机默认回环；服务器必须设置强访问令牌并启用鉴权）----
# WEB_HOST=127.0.0.1
# WEB_PORT=8770
# WORKSPACE_PROFILE=production  # 本地默认 local；生产预检要求显式鉴权
# WORKSPACE_SCHEMA_MODE=verify  # production默认且只允许verify；管理员迁移走独立CLI，不在启动时DDL
# WORKSPACE_ACCESS_TOKEN=替换为随机长令牌
# WORKSPACE_REQUIRE_AUTH=true
# WORKSPACE_MCP_TOKEN=  # 独立随机32位以上，只允许/mcp；启用业务MCP工具时必填，不得与工作台令牌相同
# WITH_RAG=true  # 容器加装 CPU 模型；false 时使用全文查询

# ---- OpenAI 兼容模型 API（未配置或失败时保留纯检索引用）----
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ---- 应用层字段加密（AES-256-GCM；密钥不入库、不写日志）----
# 优先级：SHILIE_ENCRYPTION_KEY（base64/hex） > SHILIE_ENCRYPTION_KEY_FILE > config/settings.yaml
# SHILIE_ENCRYPTION_ENABLED=true
# SHILIE_ENCRYPTION_KEY_FILE=/var/lib/shilie/encryption.key

# ---- 技巧交流区（默认不启用；当前仅8771预览）----
# COMMUNITY_PUBLIC_ORIGIN=https://8.156.81.128:8771
# COMMUNITY_SESSION_SECONDS=28800
# COMMUNITY_AI_CONCURRENCY=2
# COMMUNITY_AI_TIMEOUT=20
# schema/grants由管理员独立迁移，不在应用启动时执行：
# python -m rag_tech_retriever.platform.community_migrations         # 只列顺序
# python -m rag_tech_retriever.platform.community_migrations --emit  # 只打印SQL
# SQL包含预览数据库/端口及ON_ERROR_STOP保护；不得改用于8770正式库。
# 附件公网接口保持关闭，不能只配一个模型就认为扫描/下载已经开放。

# 思考模型的推理也消耗输出预算；仅社区引用选择使用，范围16..4096。
# COMMUNITY_AI_MAX_OUTPUT_TOKENS=512
# Anonymous feed/search cache only. Every hit checks the DB publication epoch.
# Entries=0 disables the cache; otherwise 1..256 entries, 64KiB..8MiB total.
# COMMUNITY_PUBLIC_CACHE_ENTRIES=64
# COMMUNITY_PUBLIC_CACHE_BYTES=2097152
# Web limiter state caps, not registered-user or online-user limits.
# WEB_RATE_LIMIT_MAX_CLIENTS=4096  # 1..65536 active IP keys
# WEB_RATE_LIMIT_MAX_EVENTS=131072  # 1..1048576 accepted timestamps in window
